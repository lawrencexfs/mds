    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch mds",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": ".\\mds.go",
            "args": [
                "--conf=conf.yml"
            ]
        },
        {
            "name": "Launch acmd",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "/root/dev/mds/cmd/filesvr/filesvr.go",
            "args": [
                "-addr",
                ":8031",
                "-dir",
                "/"
            ]
        },
        {
            "name": "Launch Command",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": ".\\cmd\\Command\\demo.go"
        },
        {
            "name": "Launch flxa1demo",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": ".\\cmd\\flxa.demo\\demo.go"
        },
        {
            "name": "Launch flxa2demo",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": ".\\cmd\\flxa.demo\\demo.go",
            "args": [
                "--iunithost=http://10.6.25.34:8083",
                "--iunitusername=admin",
                "--iunitpassword=123456",
                "--projectname=lua5",
                "--giturl=http://192.169.128.2:8181/wan/lua543.git",
                "--gitusername=shisiting",
                "--gitpassword=qazxsw123",
                "--gitbranch=main",
                "--commitid=e99d41eef275db19cb1b50f2860538aa7c875f4c",
                "--timeout=1800",
                "--buildid=10",
                "--jobid=1",
                "--sampleid=14",
                "--testcasetype=0,1,2,10,11",
                "--ignorefile=.txt"
            ]
        },
        {
            "name": "C++ Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "/root/dev/mds/cmd/threadpool/demo", // 替换为你的可执行文件路径
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // 替换为你的 GDB 路径
        }
    ]
